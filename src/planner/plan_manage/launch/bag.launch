<arg name="bag_drone_0" default="/home/ztr/formation_bag/0824/five/d0/5_success.bag" />
<arg name="bag_drone_1" default="/home/ztr/formation_bag/0824/five/d1/5_success.bag" />
<arg name="bag_drone_2" default="/home/ztr/formation_bag/0824/five/d2/5_success.bag" />
<arg name="bag_drone_3" default="/home/ztr/formation_bag/0824/five/d3/5_success.bag" />
<arg name="bag_drone_4" default="/home/ztr/formation_bag/0824/five/d4/5_success.bag" />



    <node pkg="rosbag" name="drone_0" type="play" output="screen" args="-l  $(arg bag_drone_0)">
        <remap from="/corrected_imu_propagate_odom" to="/drone0/corrected_imu_propagate_odom"/>
        <remap from="/vins_estimator/imu_propagate" to="/drone0/vins_estimator/imu_propagate"/>
        <remap from="/vins_estimator/path" to="/drone0/vins_estimator/path"/>
        <remap from="/ground_height_measurement" to="/drone0/ground_height_measurement"/>
        <remap from="/broadcast_localgoal_from_planner" to="/drone0/broadcast_localgoal_from_planner"/>
        <remap from="/nlink_linktrack_nodeframe3" to="/drone0/nlink_linktrack_nodeframe3"/>
    </node>

    <node pkg="rosbag" name="drone_1" type="play" output="screen" args="-l    $(arg bag_drone_1)">
        <remap from="/corrected_imu_propagate_odom" to="/drone1/corrected_imu_propagate_odom"/>
        <remap from="/vins_estimator/imu_propagate" to="/drone1/vins_estimator/imu_propagate"/>
        <remap from="/ground_height_measurement" to="/drone1/ground_height_measurement"/>
        <remap from="/vins_estimator/path" to="/drone1/vins_estimator/path"/>
        <remap from="/nlink_linktrack_nodeframe3" to="/drone1/nlink_linktrack_nodeframe3"/>
    </node>

    <node pkg="rosbag" name="drone_2" type="play" output="screen" args="-l  $(arg bag_drone_2)">
        <remap from="/corrected_imu_propagate_odom" to="/drone2/corrected_imu_propagate_odom"/>
