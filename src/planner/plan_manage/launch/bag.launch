        <remap from="/ground_height_measurement" to="/drone2/ground_height_measurement"/>
        <remap from="/vins_estimator/path" to="/drone2/vins_estimator/path"/>
        <remap from="/nlink_linktrack_nodeframe3" to="/drone2/nlink_linktrack_nodeframe3"/>
    </node>

    <node pkg="rosbag" name="drone_3" type="play" output="screen" args="-l  $(arg bag_drone_3)">
        <remap from="/corrected_imu_propagate_odom" to="/drone3/corrected_imu_propagate_odom"/>
        <remap from="/vins_estimator/imu_propagate" to="/drone3/vins_estimator/imu_propagate"/>
        <remap from="/ground_height_measurement" to="/drone3/ground_height_measurement"/>
        <remap from="/vins_estimator/path" to="/drone3/vins_estimator/path"/>
        <remap from="/nlink_linktrack_nodeframe3" to="/drone3/nlink_linktrack_nodeframe3"/>
    </node>

    <node pkg="rosbag" name="drone_4" type="play" output="screen" args="-l  $(arg bag_drone_4)">
        <remap from="/corrected_imu_propagate_odom" to="/drone4/corrected_imu_propagate_odom"/>
        <remap from="/vins_estimator/imu_propagate" to="/drone4/vins_estimator/imu_propagate"/>
        <remap from="/ground_height_measurement" to="/drone4/ground_height_measurement"/>
        <remap from="/vins_estimator/path" to="/drone4/vins_estimator/path"/>
        <remap from="/nlink_linktrack_nodeframe3" to="/drone4/nlink_linktrack_nodeframe3"/>
    </node>

